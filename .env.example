# PetBot configuration.
#
# Two ways to use this file:
#
#   1. 1Password (recommended, no plaintext secrets on disk):
#      Keep the `op://` secret *references* below and launch with
#          op run --env-file=.env -- python -m petbot
#      `op run` resolves each reference into the process environment at launch.
#      A reference is not a credential, so this file is safe to commit/share.
#
#   2. Plaintext fallback (no 1Password):
#      Copy this file to `.env`, replace the `op://...` values with real
#      secrets, and run `python -m petbot`. `.env` is gitignored — never
#      commit it with real secrets.

# --- Required ---
DISCORD_TOKEN=op://Private/PetBot/discord_token

# dev | prod. `dev` syncs slash commands instantly to DEV_GUILD_ID;
# `prod` does a (slower, global) sync. Replaces the legacy -p/--prod flag.
ENV=dev

# Guild (server) ID used for instant slash-command sync in dev.
DEV_GUILD_ID=000000000000000000

# --- Optional: booru auth (raises rate limits; not required) ---
E621_USERNAME=op://Private/PetBot/e621_username
E621_API_KEY=op://Private/PetBot/e621_api_key
DERPIBOORU_API_KEY=op://Private/PetBot/derpibooru_api_key

# --- Optional: override the User-Agent sent to booru APIs ---
# USER_AGENT=PetBot/2.0 (https://github.com/auzbuzzard/petbot)
