# PetBot configuration: a thin edge + skill workers.
#
# Two ways to use this file:
#
#   1. 1Password (recommended, no plaintext secrets on disk):
#      Keep the `op://` secret *references* below and launch with
#          op run --env-file=.env -- python -m petbot.edge
#      `op run` resolves each reference into the process environment at launch.
#      A reference is not a credential, so this file is safe to commit/share.
#
#   2. Plaintext fallback: copy to `.env`, replace `op://...` with real secrets.
#      `.env` is gitignored — never commit it with real secrets.
#
# Each process validates only what it needs: the edge needs DISCORD_TOKEN + the
# worker address; the core worker needs booru creds + the chat model config; the
# music worker needs its own gateway token.

# ============================ Edge (always-on gateway) ========================
# Run: python -m petbot.edge  (or the `petbot-edge` script)
DISCORD_TOKEN=op://Private/PetBot/discord_token
DEV_GUILD_ID=000000000000000000

# How the edge reaches the core worker: `http` (dev/always-on) or `lambda`.
TRANSPORT=http
# transport=http  → the core worker's dispatch endpoint:
WORKER_URL=http://127.0.0.1:8000/dispatch
# transport=lambda → the core worker's Lambda function name:
# WORKER_LAMBDA=petbot-core

# ============================ Core worker (math + booru + chat) ==============
# Run: python -m petbot.workers.core  (or the `petbot-core` script)
# --- Chat LLM (provider-agnostic; no vendor lock-in) ---
# CHAT_PROVIDER: `bedrock` (prod) | `openrouter` (dev/free).
CHAT_PROVIDER=openrouter
# Bedrock model id (CHAT_PROVIDER=bedrock). Note: Bedrock does NOT host Gemma.
# CHAT_BEDROCK_MODEL=amazon.nova-lite-v1:0
# OpenRouter model id + key (CHAT_PROVIDER=openrouter). A free Gemma checkpoint:
CHAT_OPENROUTER_MODEL=google/gemma-3-27b-it:free
CHAT_OPENROUTER_API_KEY=op://Private/PetBot/openrouter_api_key

# --- Booru auth (optional; raises rate limits) ---
E621_USERNAME=op://Private/PetBot/e621_username
E621_API_KEY=op://Private/PetBot/e621_api_key
DERPIBOORU_API_KEY=op://Private/PetBot/derpibooru_api_key
# USER_AGENT=PetBot/<version> (https://github.com/auzbuzzard/petbot)

# ============================ Music worker (voice) ============================
# Run: python -m petbot.workers.music  (or the `petbot-music` script)
# Its own gateway token (a separate bot application is fine), plus the dispatch
# endpoint the edge calls for music actions.
# MUSIC_DISCORD_TOKEN=op://Private/PetBot/music_discord_token
# MUSIC_DISPATCH_PORT=8100

# ============================ Logging ========================================
# LOG_LEVEL=INFO
