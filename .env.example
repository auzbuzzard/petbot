# PetBot configuration: a thin Discord frontend + compute services.
#
# Two ways to use this file:
#
#   1. 1Password (recommended, no plaintext secrets on disk):
#      Keep the `op://` secret *references* below and launch with
#          op run --env-file=.env -- python -m petbot.frontends.discord
#      `op run` resolves each reference into the process environment at launch.
#      A reference is not a credential, so this file is safe to commit/share.
#
#   2. Plaintext fallback: copy to `.env`, replace `op://...` with real secrets.
#      `.env` is gitignored — never commit it with real secrets.
#
# Each process validates only what it needs: the frontend needs DISCORD_TOKEN + the
# service address; the core service needs booru creds + the chat model config; the
# music service needs its own gateway token.

# ===================== Discord frontend (always-on gateway) ==================
# Run: python -m petbot.frontends.discord  (or the `petbot-discord` script)
DISCORD_TOKEN=op://Private/PetBot/discord_token
DEV_GUILD_ID=000000000000000000

# How the frontend reaches the core compute service — a tagged union (only one
# variant's fields apply). SERVICE__KIND selects it.
# http (dev/always-on); the local dev service binds 127.0.0.1:8000:
SERVICE__KIND=http
SERVICE__URL=http://127.0.0.1:8000/dispatch
# lambda (prod):
# SERVICE__KIND=lambda
# SERVICE__FUNCTION_NAME=petbot-core

# How many reply-chain ancestors to fetch when reconstructing conversation history
# (a Discord-API cost bound, not a model-context bound). Default 25.
# HISTORY_MAX_TURNS=25

# ===================== Core compute service (math + booru + chat) ============
# Run: python -m petbot.services.core  (or the `petbot-core` script)
# --- Chat LLM (provider-agnostic; no vendor lock-in) — a tagged union ---
# CHAT_LLM__KIND selects the provider; only that variant's fields apply.
# openrouter (dev/free): model id + API key.
CHAT_LLM__KIND=openrouter
CHAT_LLM__MODEL=google/gemma-3-27b-it:free
CHAT_LLM__API_KEY=op://Private/PetBot/openrouter_api_key
# openai_compatible (prod): any OpenAI-compatible endpoint by base URL + key —
# e.g. Bedrock's Gemma 4 ("mantle" endpoint), or a self-hosted Ollama/vLLM.
# CHAT_LLM__KIND=openai_compatible
# CHAT_LLM__MODEL=google.gemma-4-26b-a4b
# CHAT_LLM__BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
# CHAT_LLM__API_KEY=op://Private/PetBot/bedrock_api_key
# bedrock (Converse API + IAM, no key): Nova / Claude (NOT Gemma 4).
# CHAT_LLM__KIND=bedrock
# CHAT_LLM__MODEL=amazon.nova-lite-v1:0
# --- Stylizer LLM (optional, same union) — the cheap model that restyles a slash
# result in PetBot's voice. Unset ⇒ reuse CHAT_LLM__*. Tiering is config, not code.
# CHAT_STYLIZER__KIND=bedrock
# CHAT_STYLIZER__MODEL=amazon.nova-micro-v1:0
# --- Context compaction (optional) — how an over-long conversation is shrunk *when the
# model rejects it for length* (reactive; no token budget to set). Default: sliding
# window (drop the oldest half, zero cost). `summarize` uses the stylizer-tier model.
# CHAT_CONTEXT__KIND=summarize
# Override the persona prompts (optional; sensible defaults ship as package data).
# CHAT_SYSTEM_PROMPT=You are PetBot, a friendly companion. Keep replies short.
# CHAT_STYLIZER_PROMPT=Rewrite the message below as one short line in PetBot's voice.

# --- Booru auth (optional; raises rate limits) ---
E621_USERNAME=op://Private/PetBot/e621_username
E621_API_KEY=op://Private/PetBot/e621_api_key
DERPIBOORU_API_KEY=op://Private/PetBot/derpibooru_api_key
# USER_AGENT=PetBot/<version> (https://github.com/auzbuzzard/petbot)

# ===================== Music compute service (voice) =========================
# Run: python -m petbot.services.music  (or the `petbot-music` script)
# Its own gateway token (a separate bot application is fine), plus the dispatch
# endpoint the frontend calls for music actions. Host + port are required (no default).
# MUSIC_DISCORD_TOKEN=op://Private/PetBot/music_discord_token
# MUSIC_DISPATCH_HOST=0.0.0.0
# MUSIC_DISPATCH_PORT=8100

# ============================ Logging ========================================
# LOG_LEVEL=INFO

# ====================== Observability (OpenTelemetry) ========================
# Off by default — a process emits no telemetry until OBS_ENABLED=true. Metadata
# only: tool decisions, tokens, latency, salted-hashed user id. NO message content
# is ever recorded. See docs/telemetry.md and PRIVACY.md.
# OBS_ENABLED=true
# OBS_SERVICE_NAME=petbot-core           # the service node in X-Ray (edge: petbot-edge)
# OBS_SAMPLE_RATIO=1.0                    # head sampling for root traces (1.0 = all)
# OBS_ID_SALT=op://Private/PetBot/telemetry_id_salt   # salt for the user-id hash
# Standard OTLP endpoint (the ADOT collector). The SDK reads these directly.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
