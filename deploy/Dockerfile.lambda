# PetBot brain-worker Lambda image — the serverless compute side of A3a.
#
# The brain worker hosts math + booru search + the chat agent and is invoked by
# the always-on edge with a SkillCall payload (transport=lambda). A container
# image (not a zip) because the worker pulls in C-extensions (numexpr/numpy for
# /math) and a fat dependency set (pydantic-ai); the AWS Lambda Python base image
# gives a matching manylinux runtime with no wheel wrangling.
#
# Build from the repository root (the context must see the whole uv workspace):
#
#   docker build -f deploy/Dockerfile.lambda -t <ecr_url>:<tag> .
#
# Keep the runtime in lockstep with what CI tests (pyproject requires-python,
# mypy, ruff all target 3.12).
FROM public.ecr.aws/lambda/python:3.12

# uv resolves + installs far faster than pip and reuses a build-cache mount.
# Pulled from the published static binary, pinned to an immutable version tag.
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /bin/uv

# ${LAMBDA_TASK_ROOT} is /var/task, already the WORKDIR and on sys.path. The
# brain worker is a uv workspace member, so the build needs the workspace root
# pyproject + lockfile and every member it depends on (domain, types, platform,
# the math/booru/chat skills, and the brain worker bundle itself).
COPY pyproject.toml uv.lock README.md ./
COPY domain ./domain
COPY types ./types
COPY platform ./platform
COPY skills ./skills
COPY workers/brain ./workers/brain

# Install just the brain worker (and its transitive members) into the Lambda's
# interpreter — no venv, no edge/music/discord deps. The cache mount persists
# wheel downloads between builds. No secrets are baked in — Terraform supplies
# booru creds + the chat model config as environment variables.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --compile-bytecode ./workers/brain

# module.function the Lambda runtime invokes per request.
CMD ["petbot.workers.brain.handler.handler"]
