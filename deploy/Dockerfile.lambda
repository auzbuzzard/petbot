# PetBot HTTP-Interactions Lambda image — the only deployed artifact.
#
# A container image (not a zip) because the adapter pulls in C-extensions
# (pynacl for Ed25519, numexpr/numpy for /math); the AWS Lambda Python base
# image gives a matching manylinux runtime with no wheel wrangling.
#
# Build from the repository root (the context must see pyproject.toml and
# petbot/). CI builds natively on an arm64 runner to match Graviton:
#
#   docker build -f deploy/Dockerfile.lambda -t <ecr_url>:<tag> .
#
# Match the runtime to what CI tests and the toolchain target (pyproject:
# requires-python, mypy, ruff are all 3.12). Shipping a newer interpreter than
# CI exercises would deploy an untested runtime — keep them in lockstep.
FROM public.ecr.aws/lambda/python:3.12

# uv resolves + installs far faster than pip and reuses a build-cache mount
# across builds. Pulled from the published static binary (no pip bootstrap),
# pinned to an immutable version tag — never a floating one.
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /bin/uv

# ${LAMBDA_TASK_ROOT} is /var/task, already the WORKDIR and on sys.path.
COPY pyproject.toml README.md ./
COPY petbot ./petbot

# `.[interactions]` is the lean serverless set: pynacl + base deps (httpx,
# pydantic, pydantic-settings, numexpr/numpy, python-dotenv). discord.py and
# yt-dlp are *not* base deps, so the gateway client and music stack never land
# here. --system installs into the Lambda's interpreter (no venv); the cache
# mount persists the wheel downloads between builds. No secrets are baked in —
# Terraform supplies them as environment variables (see deploy/terraform).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --compile-bytecode ".[interactions]"

# module.function the Lambda runtime invokes per request.
CMD ["petbot.frontends.interactions.app.lambda_handler"]
