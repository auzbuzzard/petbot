{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": {
      "format": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "plain",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "discord": { "level": "INFO" }
  },
  "root": {
    "level": "INFO",
    "handlers": ["stderr"]
  }
}
